---
import BaseLayout from "../layouts/BaseLayout.astro";

const gettingStartedPages = [
  {
    title: "Overview / Getting Started",
    href: "/docs/overview",
    description: "Start from BentoTUI v0.6.0 with install, first commands, and product language.",
    status: "Start"
  },
  {
    title: "CLI Commands",
    href: "/docs/cli-commands",
    description: "Reference for template-first init, add, add recipe, list, doctor, and version.",
    status: "CLI"
  },
  {
    title: "Bentos Templates",
    href: "/docs/architecture/bentos",
    description: "Primary remix templates and the full shipped bento catalog.",
    status: "Templates"
  }
];

const referencePages = [
  {
    title: "Architecture",
    href: "/docs/architecture",
    description: "Architecture contract order: theme, styles, bricks, recipes, rooms, surface, Bubble Tea frame.",
    status: "Core"
  },
  {
    title: "Bentos",
    href: "/docs/architecture/bentos",
    description: "Runnable template apps and app-shell behavior guarantees.",
    status: "Layer"
  },
  {
    title: "Rooms",
    href: "/docs/architecture/rooms",
    description: "Import-only layout contracts and room primitives.",
    status: "Layer"
  },
  {
    title: "Bricks",
    href: "/docs/architecture/bricks",
    description: "Installable copy-and-own UI building blocks.",
    status: "Layer"
  },
  {
    title: "Recipes",
    href: "/docs/architecture/recipes",
    description: "Installable copy-and-own composition flows, including vimstatus.",
    status: "Layer"
  },
  {
    title: "Theme Engine",
    href: "/docs/theme-engine",
    description: "Theme interface, built-in presets, global manager, and token contract.",
    status: "Reference"
  },
  {
    title: "Rendering and Coloring Rules",
    href: "/docs/rendering-and-coloring-rules",
    description: "Surface composition and explicit background ownership guidance.",
    status: "Reference"
  },
  {
    title: "Product Direction and Roadmap",
    href: "/docs/roadmap",
    description: "Outcome-focused direction and near-term priorities after v0.6.0.",
    status: "Direction"
  }
];
---

<BaseLayout title="BentoTUI Docs" description="BentoTUI documentation.">
  <header class="site-nav reveal" style="--delay: 40ms;">
    <a class="brand" href="/" aria-label="BentoTUI home">
      <span class="brand__name">BentoTUI</span>
      <span class="brand__badge">docs</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="/docs">Docs</a>
      <a href="/docs/theme-engine">Theme Engine</a>
      <a href="/docs/roadmap">Roadmap</a>
      <a href="https://github.com/cloudboy-jh/bentotui" aria-label="BentoTUI GitHub repository">GitHub</a>
      <button type="button" class="icon-button theme-toggle" data-theme-toggle aria-label="Switch theme" title="Switch theme">
        <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M21 14.25A8.25 8.25 0 1 1 9.75 3a7 7 0 1 0 11.25 11.25Z"></path>
        </svg>
        <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 17.25A5.25 5.25 0 1 0 12 6.75a5.25 5.25 0 0 0 0 10.5Zm0-15a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75Zm0 16.5a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-1.5a.75.75 0 0 1 .75-.75Zm9-6.75a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5a.75.75 0 0 1 .75.75Zm-16.5 0a.75.75 0 0 1-.75.75H2.25a.75.75 0 0 1 0-1.5h1.5a.75.75 0 0 1 .75.75Zm12.864 6.864a.75.75 0 0 1-1.06 1.06l-1.06-1.06a.75.75 0 0 1 1.06-1.06l1.06 1.06Zm-10.608-10.608a.75.75 0 0 1-1.06 1.06l-1.06-1.06a.75.75 0 0 1 1.06-1.06l1.06 1.06Zm10.608-1.06a.75.75 0 0 1 0 1.06l-1.06 1.06a.75.75 0 1 1-1.06-1.06l1.06-1.06a.75.75 0 0 1 1.06 0ZM6.756 17.304a.75.75 0 0 1 0 1.06l-1.06 1.06a.75.75 0 0 1-1.06-1.06l1.06-1.06a.75.75 0 0 1 1.06 0Z"></path>
        </svg>
      </button>
    </nav>
  </header>

  <main class="main-wrap docs-main">
    <section class="docs-hero section-pad reveal" style="--delay: 100ms;">
      <h1>Documentation</h1>
      <p class="hero__subtitle">BentoTUI v0.6.0 docs for bricks, recipes, rooms, bentos, and rendering contracts.</p>
    </section>

    <section class="docs-section section-pad reveal" style="--delay: 170ms;">
      <h2 class="docs-group-title">Getting Started</h2>
      <p class="docs-intro">Start here to install BentoTUI, run your first bento, and learn the current command surface.</p>
      <div class="docs-grid docs-grid--feature">
        {
          gettingStartedPages.map((page) => (
            <article class="docs-card docs-card--feature">
              <p class="docs-status">{page.status}</p>
              <h3><a href={page.href}>{page.title}</a></h3>
              <p>{page.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="docs-section section-pad reveal" style="--delay: 210ms;">
      <h2 class="docs-group-title">API and Architecture Reference</h2>
      <p class="docs-intro">Use these references for exact contracts, installable catalogs, theme APIs, and reliability guardrails.</p>
      <div class="docs-grid docs-grid--secondary">
        {
          referencePages.map((page) => (
            <article class="docs-card docs-card--feature docs-card--secondary">
              <p class="docs-status docs-status--muted">{page.status}</p>
              <h3><a href={page.href}>{page.title}</a></h3>
              <p>{page.description}</p>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .docs-group-title {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin: 0 0 0.8rem;
  }

  .docs-grid--feature {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    gap: 1rem;
  }

  .docs-intro {
    margin: 0.35rem 0 0;
    color: var(--body);
    max-width: 72ch;
  }

  .docs-grid--secondary {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    gap: 1rem;
  }

  .docs-card--secondary {
    min-height: 148px;
  }

  .docs-card--feature {
    min-height: 170px;
    padding: 1.25rem 1.1rem;
    border-radius: 0.95rem;
    border-color: color-mix(in srgb, var(--green) 26%, var(--border));
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface) 92%, white) 0%, color-mix(in srgb, var(--surface) 86%, white) 100%),
      radial-gradient(130% 120% at 0% 0%, color-mix(in srgb, var(--green) 9%, transparent) 0%, transparent 65%);
  }

  .docs-card--feature h3 {
    font-size: 1.2rem;
    letter-spacing: 0.01em;
    font-family: "Fraunces", serif;
    margin-bottom: 0.45rem;
  }

  .docs-status {
    margin: 0 0 0.36rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--green) 82%, var(--ink));
  }

  .docs-status--muted {
    color: var(--muted);
  }

  .docs-card--feature p {
    font-size: 0.98rem;
    line-height: 1.45;
    margin-top: 0;
  }

  @media (max-width: 900px) {
    .docs-grid--feature,
    .docs-grid--secondary {
      grid-template-columns: 1fr;
    }
  }
</style>

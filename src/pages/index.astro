---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Code } from "astro:components";
import bentotuiWordmarkLogo from "../../bentotui-wordmark-logo.png";

const quickStartCode = `# Install Bento CLI
go install github.com/cloudboy-jh/bentotui/cmd/bento@latest

# Add a validation app and architecture primitives
bento add app-shell panel bar surface list

# Inspect all available bentos, rooms, and bricks
bento list

# Start from copy-and-own source
bento init myapp`;

const modelCards = [
  {
    label: "Bentos",
    scope: "Full app orchestration",
    detail: "Bentos define complete user flows, scenario coverage, and screen-level behavior.",
    points: ["Own app-level states", "Coordinate focus flows", "Drive validation scenarios"]
  },
  {
    label: "Rooms",
    scope: "Geometry and allocation",
    detail: "Rooms compose layout geometry, split policy, and viewport adaptation across screens.",
    points: ["Allocate width and height", "Use `WithGutter` and `WithDivider`", "Keep layout deterministic"]
  },
  {
    label: "Bricks",
    scope: "Reusable UI rendering",
    detail: "Bricks render components with stable contracts so teams can upgrade behavior safely.",
    points: ["Paint visual components", "Preserve compatibility", "Harden ANSI-heavy rendering"]
  }
];

const docLinks = [
  {
    title: "Architecture",
    href: "/docs/architecture",
    text: "Canonical freeze contract, validation tuple, and model boundaries."
  },
  {
    title: "Untouchable Theme Engine",
    href: "/docs/theme-engine",
    text: "Theme semantics, token responsibilities, and rendering rules."
  },
  {
    title: "Roadmap",
    href: "/docs/roadmap",
    text: "Execution priorities, quality gates, and what ships next."
  },
  {
    title: "Next Steps",
    href: "/docs/next-steps",
    text: "Immediate tasks for validation breadth and contract hardening."
  }
];
---

<BaseLayout>
  <header class="site-nav reveal" style="--delay: 40ms;">
    <a class="brand brand--wordmark" href="#top" aria-label="BentoTUI home">
      <img class="brand__logo" src={bentotuiWordmarkLogo.src} alt="BentoTUI" />
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="/docs">Docs</a>
      <a href="/docs/theme-engine">Theme Engine</a>
      <a href="/docs/roadmap">Roadmap</a>
      <a href="https://github.com/cloudboy-jh/bentotui">GitHub</a>
      <button type="button" class="icon-button theme-toggle" data-theme-toggle aria-label="Switch theme">
        <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24"><path d="M21 14.25A8.25 8.25 0 1 1 9.75 3a7 7 0 1 0 11.25 11.25Z"/></svg>
        <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24"><path d="M12 17.25A5.25 5.25 0 1 0 12 6.75a5.25 5.25 0 0 0 0 10.5Z"/></svg>
      </button>
    </nav>
  </header>

  <main id="top" class="main-wrap">
    <section class="hero section-pad reveal" style="--delay: 120ms;">
      <img class="hero__logo" src={bentotuiWordmarkLogo.src} alt="BentoTUI" />
      <p class="hero__subtitle">Copy-and-own TUI architecture for Bubble Tea v2.</p>
      <p class="hero__pitch">
        BentoTUI now ships with a frozen contract: <code>bentos</code>, <code>rooms</code>, and <code>bricks</code>.
        Apps move faster because responsibilities are explicit and visual semantics are centralized in the Untouchable Theme Engine.
      </p>
      <div class="install-pill reveal" style="--delay: 200ms;">
        <code>go install github.com/cloudboy-jh/bentotui/cmd/bento@latest</code>
      </div>
    </section>

    <section class="section-pad section-body reveal" style="--delay: 210ms;">
      <h2>Copy and compose</h2>
      <p class="section-copy">
        The CLI copies source into your repository so your team owns delivery. Start with a bento, compose rooms,
        and paint with bricks while keeping framework validation reproducible.
      </p>
      <div class="code-frame">
        <Code lang="bash" code={quickStartCode} />
      </div>
    </section>

    <section class="section-pad section-body reveal" style="--delay: 250ms;">
      <h2>Bentos, rooms, bricks</h2>
      <p class="section-copy">
        The architecture model is intentionally strict: bentos orchestrate behavior, rooms allocate geometry,
        and bricks paint reusable UI components.
      </p>

      <div class="model-grid">
        {
          modelCards.map((card) => (
            <article class="model-card">
              <p class="model-card__label">{card.label}</p>
              <h3>{card.scope}</h3>
              <p>{card.detail}</p>
              <ul>
                {card.points.map((point) => (<li>{point}</li>))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section-pad section-body reveal" style="--delay: 290ms;">
      <h2>Untouchable Theme Engine</h2>
      <p class="section-copy">
        Theme semantics are global and non-negotiable at the contract layer. The theme engine removes per-screen color glue,
        keeps rendering coherent, and makes scenario snapshots meaningful across viewports.
      </p>

      <div class="theme-principles">
        <article>
          <h3>Global semantics</h3>
          <p>Tokens and style mappings are shared across bentos, rooms, and bricks.</p>
        </article>
        <article>
          <h3>Deterministic validation</h3>
          <p><code>app-shell</code> validates scenarios with <code>scenario + viewport + theme + focus + snapshot</code>.</p>
        </article>
        <article>
          <h3>No local drift</h3>
          <p>Theme behavior is centralized so product teams avoid one-off palette logic.</p>
        </article>
      </div>
    </section>

    <section class="section-pad section-body reveal" style="--delay: 330ms;">
      <h2>Defined docs path</h2>
      <p class="section-copy">
        The docs set now mirrors the frozen architecture and execution flow. Use these in order when onboarding contributors.
      </p>
      <div class="docs-path-grid">
        {
          docLinks.map((item) => (
            <article class="docs-path-card">
              <h3><a href={item.href}>{item.title}</a></h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="site-footer reveal" style="--delay: 420ms;">
    <p>BentoTUI - copy-and-own architecture with bentos, rooms, bricks, and the Untouchable Theme Engine.</p>
    <div class="footer-links">
      <a href="https://github.com/cloudboy-jh/bentotui">GitHub</a>
      <a href="/docs">Docs</a>
    </div>
  </footer>
</BaseLayout>

<style>
  .section-copy {
    margin-top: 0.55rem;
    color: var(--body);
    max-width: 72ch;
  }

  .model-grid {
    margin-top: 1.2rem;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .model-card {
    border: 1px solid var(--border);
    border-radius: 0.82rem;
    padding: 1rem;
    background: color-mix(in srgb, var(--surface) 90%, white);
  }

  .model-card__label {
    margin: 0 0 0.35rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .model-card h3 {
    margin: 0;
    font-family: "Outfit", sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0;
  }

  .model-card p {
    margin: 0.45rem 0;
  }

  .model-card ul {
    margin: 0.4rem 0 0;
    padding-left: 1rem;
  }

  .theme-principles {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .theme-principles article {
    border: 1px solid var(--border);
    border-radius: 0.78rem;
    padding: 0.85rem 0.9rem;
    background: color-mix(in srgb, var(--surface) 92%, white);
  }

  .theme-principles h3 {
    margin: 0;
    font-size: 0.78rem;
    text-transform: uppercase;
    color: var(--muted);
  }

  .theme-principles p {
    margin: 0.45rem 0 0;
    color: var(--body);
  }

  .docs-path-grid {
    margin-top: 1.1rem;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .docs-path-card {
    border: 1px solid var(--border);
    border-radius: 0.8rem;
    padding: 0.95rem;
    background: color-mix(in srgb, var(--surface) 90%, white);
  }

  .docs-path-card h3 {
    margin: 0;
    font-size: 0.88rem;
  }

  .docs-path-card h3 a {
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }

  .docs-path-card p {
    margin: 0.45rem 0 0;
  }

  @media (max-width: 900px) {
    .model-grid,
    .theme-principles,
    .docs-path-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

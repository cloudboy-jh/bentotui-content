---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Code } from "astro:components";
import bentotuiWordmarkLogo from "../../bentotui-wordmark-logo.png";

const quickStartCode = `# Install BentoTUI and CLI
go get github.com/cloudboy-jh/bentotui
go install github.com/cloudboy-jh/bentotui/cmd/bento@latest

# Launch interactive installer/launcher
bento

# Start from a runnable template app
go run ./registry/bentos/home-screen

# Copy a brick into your app
bento add card`;

const modelCards = [
  {
    label: "Bentos",
    scope: "Full app orchestration",
    detail: "Runnable template apps under registry/bentos/* let teams remix full experiences quickly.",
    points: ["Start with home-screen", "Remix app-shell", "Ship serious shells fast"]
  },
  {
    label: "Rooms",
    scope: "Geometry and allocation",
    detail: "Import-only layout contracts from registry/rooms keep geometry stable and predictable.",
    points: ["Geometry only", "No theme ownership", "Deterministic composition"]
  },
  {
    label: "Bricks",
    scope: "Reusable UI rendering",
    detail: "Official UI blocks are copied into your codebase with bento add <brick>.",
    points: ["Copy and own source", "Adapt without lock-in", "Upgrade on your timeline"]
  }
];

const docLinks = [
  {
    title: "Overview / Getting Started",
    href: "/docs/overview",
    text: "Product framing, install path, and first-run flow for BentoTUI v0.5.4."
  },
  {
    title: "Bricks API",
    href: "/docs/architecture/bricks",
    text: "Installable bricks catalog and copy-and-own contracts."
  },
  {
    title: "Rooms API",
    href: "/docs/architecture/rooms",
    text: "Import-only room contracts and geometry primitives."
  },
  {
    title: "Theme Engine",
    href: "/docs/theme-engine",
    text: "Theme interface, presets, manager APIs, and diff/syntax tokens."
  }
];
---

<BaseLayout>
  <header class="site-nav reveal" style="--delay: 40ms;">
    <a class="brand brand--wordmark" href="#top" aria-label="BentoTUI home">
      <img class="brand__logo" src={bentotuiWordmarkLogo.src} alt="BentoTUI" />
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="/docs">Docs</a>
      <a href="/docs/theme-engine">Theme Engine</a>
      <a href="/docs/roadmap">Roadmap</a>
      <a href="https://github.com/cloudboy-jh/bentotui">GitHub</a>
      <button type="button" class="icon-button theme-toggle" data-theme-toggle aria-label="Switch theme">
        <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24"><path d="M21 14.25A8.25 8.25 0 1 1 9.75 3a7 7 0 1 0 11.25 11.25Z"/></svg>
        <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24"><path d="M12 17.25A5.25 5.25 0 1 0 12 6.75a5.25 5.25 0 0 0 0 10.5Z"/></svg>
      </button>
    </nav>
  </header>

  <main id="top" class="main-wrap">
    <section class="hero section-pad reveal" style="--delay: 120ms;">
      <img class="hero__logo" src={bentotuiWordmarkLogo.src} alt="BentoTUI" />
      <p class="hero__subtitle">Build full Go TUIs fast.</p>
      <p class="hero__pitch">
        BentoTUI is the fastest way to build full Go TUIs using copy-and-own bricks and recipes,
        import-only room layouts, and runnable bento templates.
      </p>
      <div class="install-pill reveal" style="--delay: 200ms;">
        <code>Current docs snapshot: v0.5.4</code>
      </div>
    </section>

    <section class="section-pad section-body reveal" style="--delay: 210ms;">
      <h2>Ship in days, not weeks</h2>
      <p class="section-copy">
        BentoTUI gives Go teams a production-oriented TUI system: copy-and-own bricks and recipes,
        stable room contracts, and runnable bentos to remix quickly.
      </p>
      <div class="code-frame">
        <Code lang="bash" code={quickStartCode} />
      </div>
    </section>

    <section class="section-pad section-body reveal" style="--delay: 250ms;">
      <h2>Bricks, recipes, rooms, bentos</h2>
      <p class="section-copy">
        Use Bento vocabulary end-to-end: copy bricks and recipes into app code, compose with room contracts,
        and launch full bento templates for rapid delivery.
      </p>

      <div class="model-grid">
        {
          modelCards.map((card) => (
            <article class="model-card">
              <p class="model-card__label">{card.label}</p>
              <h3>{card.scope}</h3>
              <p>{card.detail}</p>
              <ul>
                {card.points.map((point) => (<li>{point}</li>))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section-pad section-body reveal" style="--delay: 290ms;">
      <h2>Reliable by design</h2>
      <p class="section-copy">
        Guardrails enforce clean boundaries so teams avoid architecture drift: rooms stay geometry-only,
        bricks do not import bricks, and app-level theme state is model-owned.
      </p>

      <div class="theme-principles">
        <article>
          <h3>Copy-and-own UI</h3>
          <p>Bricks and recipes are copied into your repo so your team owns behavior and release timing.</p>
        </article>
        <article>
          <h3>Import-only layouts</h3>
          <p>Rooms stay stable as geometry contracts with no color or theme decisions.</p>
        </article>
        <article>
          <h3>Deterministic app-shell</h3>
          <p>v0.5.4 keeps command palette ordering deterministic and theme updates consistent.</p>
        </article>
      </div>
    </section>

    <section class="section-pad section-body reveal" style="--delay: 330ms;">
      <h2>Defined docs path</h2>
      <p class="section-copy">
        Follow the updated docs IA for current APIs, install catalogs, and rendering contracts.
      </p>
      <div class="docs-path-grid">
        {
          docLinks.map((item) => (
            <article class="docs-path-card">
              <h3><a href={item.href}>{item.title}</a></h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="site-footer reveal" style="--delay: 420ms;">
    <p>BentoTUI - copy-and-own bricks and recipes, import-only rooms, and runnable bentos.</p>
    <div class="footer-links">
      <a href="https://github.com/cloudboy-jh/bentotui">GitHub</a>
      <a href="/docs">Docs</a>
    </div>
  </footer>
</BaseLayout>

<style>
  .section-copy {
    margin-top: 0.55rem;
    color: var(--body);
    max-width: 72ch;
  }

  .model-grid {
    margin-top: 1.2rem;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .model-card {
    border: 1px solid var(--border);
    border-radius: 0.82rem;
    padding: 1rem;
    background: color-mix(in srgb, var(--surface) 90%, white);
  }

  .model-card__label {
    margin: 0 0 0.35rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .model-card h3 {
    margin: 0;
    font-family: "Outfit", sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0;
  }

  .model-card p {
    margin: 0.45rem 0;
  }

  .model-card ul {
    margin: 0.4rem 0 0;
    padding-left: 1rem;
  }

  .theme-principles {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .theme-principles article {
    border: 1px solid var(--border);
    border-radius: 0.78rem;
    padding: 0.85rem 0.9rem;
    background: color-mix(in srgb, var(--surface) 92%, white);
  }

  .theme-principles h3 {
    margin: 0;
    font-size: 0.78rem;
    text-transform: uppercase;
    color: var(--muted);
  }

  .theme-principles p {
    margin: 0.45rem 0 0;
    color: var(--body);
  }

  .docs-path-grid {
    margin-top: 1.1rem;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .docs-path-card {
    border: 1px solid var(--border);
    border-radius: 0.8rem;
    padding: 0.95rem;
    background: color-mix(in srgb, var(--surface) 90%, white);
  }

  .docs-path-card h3 {
    margin: 0;
    font-size: 0.88rem;
  }

  .docs-path-card h3 a {
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }

  .docs-path-card p {
    margin: 0.45rem 0 0;
  }

  @media (max-width: 900px) {
    .model-grid,
    .theme-principles,
    .docs-path-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
